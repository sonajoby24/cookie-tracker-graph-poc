import pandas as pd

EXPECTED_COLUMNS = [
    "name", "value", "domain", "path", "expires", "httpOnly",
    "secure", "sameSite", "source_url"
]

def normalize_cookies(raw_items):
    if not raw_items:
        return pd.DataFrame(columns=EXPECTED_COLUMNS)

    df = pd.DataFrame(raw_items)

    for col in EXPECTED_COLUMNS:
        if col not in df.columns:
            df[col] = None

    df["domain"] = df["domain"].fillna("unknown").astype(str)
    df["name"] = df["name"].fillna("unnamed").astype(str)
    df["path"] = df["path"].fillna("/").astype(str)
    df["sameSite"] = df["sameSite"].fillna("Unknown").astype(str)
    df["secure"] = df["secure"].fillna(False).astype(bool)
    df["httpOnly"] = df["httpOnly"].fillna(False).astype(bool)

    df["category"] = df["name"].apply(classify_cookie)
    df["party_type"] = df["domain"].apply(classify_party_type)

    return df

def classify_cookie(name: str) -> str:
    token = name.lower()
    if any(k in token for k in ["ga", "_ga", "gid", "analytics", "pk_"]):
        return "Analytics"
    if any(k in token for k in ["ad", "fb", "_fb", "doubleclick", "track"]):
        return "Marketing"
    if any(k in token for k in ["sess", "csrf", "auth", "token"]):
        return "Essential"
    return "Unknown"

def classify_party_type(domain: str) -> str:
    if domain.startswith(".") or domain.count(".") >= 2:
        return "Third-Party"
    return "First-Party"
