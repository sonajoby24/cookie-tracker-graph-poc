def build_graph(df):
    nodes = []
    edges = []
    seen = set()

    site_id = "site:target"
    nodes.append({"id": site_id, "label": "Target Site", "type": "site"})

    for _, row in df.iterrows():
        domain_id = f"domain:{row['domain']}"
        cookie_id = f"cookie:{row['domain']}:{row['name']}"
        category_id = f"category:{row['category']}"

        for node_id, label, node_type in [
            (domain_id, row["domain"], "domain"),
            (cookie_id, row["name"], "cookie"),
            (category_id, row["category"], "category"),
        ]:
            if node_id not in seen:
                nodes.append({"id": node_id, "label": label, "type": node_type})
                seen.add(node_id)

        edges.append({"id": f"{site_id}->{domain_id}", "source": site_id, "target": domain_id})
        edges.append({"id": f"{domain_id}->{cookie_id}", "source": domain_id, "target": cookie_id})
        edges.append({"id": f"{cookie_id}->{category_id}", "source": cookie_id, "target": category_id})

    deduped = {edge["id"]: edge for edge in edges}
    return {"nodes": nodes, "edges": list(deduped.values())}
