<file path="backend/main.py">
from pathlib import Path
import json
from fastapi import FastAPI
from fastapi.responses import JSONResponse, StreamingResponse
from fastapi.middleware.cors import CORSMiddleware
from services.normalize import normalize_cookies
from services.metrics import build_metrics
from services.graph_builder import build_graph
import io

BASE_DIR = Path(__file__).resolve().parent
DATA_FILE = BASE_DIR / "data" / "scans" / "cookies.json"

app = FastAPI(title="Cookie Tracker Graph Intelligence API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

SYNTHETIC_DATA = [
    {"name": "_ga", "value": "x", "domain": ".google-analytics.com", "path": "/", "secure": True, "httpOnly": False, "sameSite": "None", "source_url": "synthetic"},
    {"name": "sessionid", "value": "y", "domain": "targetsite.com", "path": "/", "secure": True, "httpOnly": True, "sameSite": "Lax", "source_url": "synthetic"},
    {"name": "_fbp", "value": "z", "domain": ".facebook.com", "path": "/", "secure": True, "httpOnly": False, "sameSite": "None", "source_url": "synthetic"},
]

def load_raw():
    if DATA_FILE.exists():
        try:
            payload = json.loads(DATA_FILE.read_text(encoding="utf-8"))
            if isinstance(payload, list) and len(payload) > 0:
                return payload, "Live"
        except Exception:
            pass
    return SYNTHETIC_DATA, "Synthetic"

@app.get("/summary")
def summary():
    raw, status = load_raw()
    df = normalize_cookies(raw)
    metrics = build_metrics(df)
    return {"sourceStatus": status, "metrics": metrics}

@app.get("/graph")
def graph():
    raw, status = load_raw()
    df = normalize_cookies(raw)
    return {"sourceStatus": status, "graph": build_graph(df)}

@app.get("/cookies")
def cookies():
    raw, status = load_raw()
    df = normalize_cookies(raw)
    return {"sourceStatus": status, "rows": df.to_dict(orient="records")}

@app.get("/source-status")
def source_status():
    raw, status = load_raw()
    return {"sourceStatus": status, "recordCount": len(raw)}

@app.get("/download/json")
def download_json():
    raw, status = load_raw()
    buffer = io.BytesIO(json.dumps(raw, indent=2).encode("utf-8"))
    return StreamingResponse(
        buffer,
        media_type="application/json",
        headers={"Content-Disposition": "attachment; filename=cookie-sample.json"}
    )

@app.get("/download/csv")
def download_csv():
    raw, status = load_raw()
    df = normalize_cookies(raw)
    buffer = io.StringIO()
    df.to_csv(buffer, index=False)
    return StreamingResponse(
        iter([buffer.getvalue()]),
        media_type="text/csv",
        headers={"Content-Disposition": "attachment; filename=cookie-sample.csv"}
    )
