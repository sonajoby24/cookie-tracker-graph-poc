def build_metrics(df):
    total = len(df)
    unique_domains = int(df["domain"].nunique()) if not df.empty else 0
    third_party = int((df["party_type"] == "Third-Party").sum()) if not df.empty else 0
    analytics = int((df["category"] == "Analytics").sum()) if not df.empty else 0

    return {
        "totalCookies": total,
        "uniqueDomains": unique_domains,
        "thirdPartyCookies": third_party,
        "analyticsCookies": analytics,
    }
